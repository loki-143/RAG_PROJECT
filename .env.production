# ============================================================
# CodeSense Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env with real credentials to version control
# ============================================================

# ──────────────────────────────────────────────────────────────────
# LLM API Keys (REQUIRED - At least one must be set)
# ──────────────────────────────────────────────────────────────────

# GitHub Models API Token (Primary LLM provider - RECOMMENDED)
# Get from: https://github.com/settings/tokens
# Requires: repo scope enabled
GITHUB_TOKEN=your_github_token_here

# Google Gemini API Key (Fallback option)
# Get from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Local Ollama Model (Optional - requires Ollama installed)
OLLAMA_MODEL=llama3

# ──────────────────────────────────────────────────────────────────
# Frontend Configuration
# ──────────────────────────────────────────────────────────────────

# API URL for frontend (use /api for nginx reverse proxy)
VITE_API_URL=/api

# ──────────────────────────────────────────────────────────────────
# Performance Configuration
# ──────────────────────────────────────────────────────────────────

# Parallel Indexing (File Chunking)
USE_PARALLEL_INDEXING=true
INDEXING_MAX_WORKERS=0

# Parallel Embeddings (WARNING: Can cause CPU lag on low-end systems)
# Recommended: false for 2-4 cores, true for 6+ cores
USE_PARALLEL_EMBEDDINGS=false
PARALLEL_EMBEDDING_THRESHOLD=5000
EMBEDDING_BATCH_SIZE=500

# API Workers
MAX_WORKERS=8

# ──────────────────────────────────────────────────────────────────
# Application Settings
# ──────────────────────────────────────────────────────────────────

ENVIRONMENT=production
LOG_LEVEL=INFO
